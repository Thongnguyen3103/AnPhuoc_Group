# Copy thành .env rồi sửa. Biến môi trường có sẵn được ưu tiên hơn file này.

# Địa chỉ lắng nghe (0.0.0.0 = mọi card mạng) và cổng
APP_HOST=0.0.0.0
APP_PORT=8780

# Thư mục dữ liệu của app (CSDL, snapshot, log). Mặc định: Report_Summary_App/data
# DATA_DIR=D:\AnPhuocGroup\AnPhuoc_Data\01.Python_Projects\03.Projects\Report_Summary_App\data

# Nơi pipeline build xuất snapshot (có thể là đường dẫn mạng \\may-build\...\app_snapshot)
# SNAPSHOT_SOURCE_DIR=D:\AnPhuocGroup\AnPhuoc_Data\01.Python_Projects\04.Output\Report_Summary\app_snapshot

# Giao diện báo cáo (dùng chung với file HTML offline)
# TEMPLATE_DIR=D:\AnPhuocGroup\AnPhuoc_Data\01.Python_Projects\03.Projects\Report_Summary_App\Template

# Phiên đăng nhập (giờ), cookie chỉ gửi qua HTTPS (bật khi đặt sau reverse proxy HTTPS)
SESSION_HOURS=12
COOKIE_SECURE=false

# Giữ bao nhiêu bản dữ liệu cũ; chu kỳ kiểm tra bản build mới (giây)
SNAPSHOT_KEEP=12
WATCH_INTERVAL_SEC=60

# Khóa đăng nhập sau N lần sai trong M phút
LOGIN_MAX_FAILURES=5
LOGIN_WINDOW_MIN=15

# Nguồn gốc khác được phép gọi API thay đổi dữ liệu (vd khi truy cập qua tên miền nội bộ), cách nhau dấu phẩy
# TRUSTED_ORIGINS=http://baocao.anphuoc.local
